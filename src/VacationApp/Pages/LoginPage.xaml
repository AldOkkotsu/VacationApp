<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VacationApp.Pages.LoginPage"
             Title="Vacation · Iniciar sesión"
             NavigationPage.HasNavigationBar="False">
    <ScrollView>
        <VerticalStackLayout Padding="24,32" Spacing="24" MaximumWidthRequest="560"
                             HorizontalOptions="Fill" VerticalOptions="Center">
            <Border BackgroundColor="{StaticResource Navy}" StrokeThickness="0"
                    StrokeShape="RoundRectangle 24" Padding="28">
                <VerticalStackLayout Spacing="14">
                    <Label Text="VACATION" TextColor="#83DDD1" FontSize="14"
                           FontAttributes="Bold" CharacterSpacing="3" />
                    <Label Text="Tu descanso,&#10;bien organizado." TextColor="White"
                           FontSize="32" FontAttributes="Bold" LineHeight="1.1" />
                    <Label Text="Solicita tus vacaciones y sigue cada paso de la aprobación."
                           TextColor="#CDDCE9" FontSize="16" LineHeight="1.3" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="18">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Bienvenido" FontSize="26" FontAttributes="Bold" />
                        <Label Text="Elige una cuenta para explorar su perfil." Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Cuenta de demostración" FontAttributes="Bold" FontSize="14" />
                        <Picker x:Name="AccountPicker" Title="Selecciona una cuenta" ItemDisplayBinding="{Binding Label}"
                                SemanticProperties.Description="Cuenta y perfil con los que deseas iniciar sesión" />
                        <Label x:Name="AccountEmailLabel" Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Contraseña" FontAttributes="Bold" FontSize="14" />
                        <Entry x:Name="PasswordEntry" IsPassword="True" Placeholder="Contraseña de la cuenta"
                               ReturnType="Go" Completed="OnSignInClicked"
                               SemanticProperties.Description="Contraseña de la cuenta de demostración" />
                        <Label x:Name="DemoPasswordLabel" Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                    <Label x:Name="ErrorLabel" TextColor="{StaticResource Danger}" IsVisible="False"
                           SemanticProperties.Description="Error al iniciar sesión" />
                    <Button x:Name="SignInButton" Text="Iniciar sesión" Clicked="OnSignInClicked" />
                    <ActivityIndicator x:Name="SignInActivity" IsVisible="False" Color="{StaticResource Primary}" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="8" Padding="4,0">
                <Label Text="Un flujo, cuatro perfiles" FontAttributes="Bold" />
                <Label Text="Empleado solicita · Líder revisa · Recursos Humanos aprueba · Nómina registra"
                       Style="{StaticResource Caption}" />
                <Border BackgroundColor="{StaticResource PrimarySoft}" StrokeThickness="0"
                        StrokeShape="RoundRectangle 12" Padding="14" Margin="0,8,0,0">
                    <Label Text="Modo demo local. Utiliza datos ficticios; el inicio de sesión es solo para probar los perfiles."
                           TextColor="#176967" FontSize="13" LineHeight="1.2" />
                </Border>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
